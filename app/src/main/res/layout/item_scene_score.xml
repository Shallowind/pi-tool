<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <!-- 分类颜色指示条 -->
        <View
                android:id="@+id/category_indicator"
                android:layout_width="4dp"
                android:layout_height="0dp"
                android:background="@color/positive_green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- 序号（分类内序号） -->
        <TextView
                android:id="@+id/tv_sequence"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="#1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/category_indicator"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- 场景图标 -->
        <com.zmmxkid.pitool.DiagonalCutImageView
                android:id="@+id/iv_scene"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cutRatio="0.2"
                app:layout_constraintStart_toEndOf="@id/tv_sequence"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- 分类标签（带颜色） -->
        <TextView
                android:id="@+id/tv_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="[主游戏]"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FF4444"
                app:layout_constraintStart_toEndOf="@id/iv_scene"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- 场景名 -->
        <TextView
                android:id="@+id/tv_scene_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="场景名称"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tv_score"
                app:layout_constraintStart_toEndOf="@id/iv_scene"
                app:layout_constraintTop_toBottomOf="@id/tv_category_label" />

        <!-- 详细排名 -->
        <TextView
                android:id="@+id/tv_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="排名: -- / --"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_scene_name"
                app:layout_constraintStart_toEndOf="@id/iv_scene"
                app:layout_constraintTop_toBottomOf="@id/tv_scene_name" />

        <!-- 分数 -->
        <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tv_percentage"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- 百分比 -->
        <TextView
                android:id="@+id/tv_percentage"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.00%"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>