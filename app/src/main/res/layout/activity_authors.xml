<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main">

    <!-- 顶部 Logo + 标题 -->
    <LinearLayout
            android:id="@+id/topArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:srcCompat="@mipmap/logo_round"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PI Tool"
                android:textStyle="bold"
                android:textSize="36sp"
                android:textColor="@color/text_main"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Version 4.5.0 正式版"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <!-- 信息卡片 -->
    <androidx.cardview.widget.CardView
            android:id="@+id/infoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            app:layout_constraintTop_toBottomOf="@id/topArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="20dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开发者信息"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="本应用由 kid（2334232884）独立开发\n由 Gyrfalcon（380593916）提供后端代码支持"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"/>

            <TextView
                    android:id="@+id/textView18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="喜欢的话可以wx扫码请我喝一杯冰可乐🧊"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 赞助区域 -->
    <LinearLayout
            android:id="@+id/payArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/infoCard"
            app:layout_constraintBottom_toTopOf="@id/button10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:layout_width="135dp"
                android:layout_height="222dp"
                app:srcCompat="@drawable/code"/>

        <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="260dp"
                android:fadeScrollbars="false"
                android:layout_marginStart="16dp">

            <TextView
                    android:id="@+id/textView33"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>
        </ScrollView>
    </LinearLayout>

    <!-- 检查更新按钮 -->
    <Button
            android:id="@+id/button10"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_margin="24dp"
            android:text="检查更新"
            android:textSize="18sp"
            android:background="@drawable/select_button"
            android:onClick="gengxin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
